---
// The form renders ONLY when a real Turnstile site key is configured.
//
// This used to fall back to Cloudflare's always-passes test key
// (1x00000000000000000000AA) whenever the fixture flag was set, which meant a
// preview build shipped a form that looked live and could never work — the
// Worker has no TURNSTILE_SECRET to verify against, so every submission 403s.
// A signup form that always errors is worse than no signup form: it collects
// intent and drops it.
//
// So presence is now a function of whether the thing is actually built. No key,
// no form, no way for anyone to submit into a void. Set
// PUBLIC_TURNSTILE_SITE_KEY and the form comes back on the next build.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() || '';
const testKeys = new Set(['1x00000000000000000000AA', '2x00000000000000000000AB', '3x00000000000000000000FF']);
const ready = siteKey.length > 0 && !testKeys.has(siteKey);
if (siteKey && !ready) {
  throw new Error(
    'PUBLIC_TURNSTILE_SITE_KEY is a Cloudflare Turnstile TEST key. Test keys accept '
    + 'any visitor, so they must never reach a build. Use the real site key, or unset it '
    + 'to omit the form.',
  );
}
---

{ready ? (
  <section class="signup" aria-labelledby="signup-title">
    <p class="eyebrow">Optional, no strings attached</p>
    <h2 id="signup-title">Get new workouts by email.</h2>
    <p class="prose">A short note when a new session is ready. No challenges, countdowns, or daily noise.</p>
    <form action="/api/subscribe" method="post">
      <div class="signup__fields">
        <label>First name<input name="first_name" autocomplete="given-name" maxlength="80" required /></label>
        <label>Last name<input name="last_name" autocomplete="family-name" maxlength="80" required /></label>
        <label>Email<input type="email" name="email" autocomplete="email" maxlength="254" required /></label>
      </div>
      <input type="hidden" name="source" value="homepage" />
      <div class="signup__actions">
        <div class="cf-turnstile" data-sitekey={siteKey} data-action="subscribe"></div>
        <button type="submit">Send me new workouts</button>
      </div>
      <p class="form-note">Completely optional. Unsubscribe whenever you like.</p>
    </form>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </section>
) : null}
