---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="3-2-1 Log | SilverBack Barbell Club" description="3-2-1 Log is the training log used to run SilverBack Barbell Club sessions." canonicalPath="/app/">
  <section class="page-section">
    <div class="site-shell">
      <p class="eyebrow">The training log we use</p>
      <h1>3-2-1 Log</h1>
      <div class="prose">
        <p>3-2-1 Log is where we run these sessions: the work, the rest, and the record of what happened. It keeps the training clear without asking the website to become an app.</p>
        <p><a href="https://pro.threetwone.com/">Open 3-2-1 Log</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
